
# ==========================================
# DevOpsMind AI - Git Ignore
# ==========================================

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python build files
build/
dist/
*.egg-info/
.eggs/

# Testing and coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Node.js
node_modules/
**/node_modules/

# React / Vite build
frontend/dist/
frontend/build/
.vite/

# npm logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment variables and secrets
.env
.env.*
!.env.example
!**/.env.example

# Credentials and private keys
*.pem
*.key
secrets/
credentials/

# Database files
*.db
*.sqlite
*.sqlite3

# Logs and temporary files
*.log
logs/
tmp/
temp/
uploads/temp/

# IDE files
.vscode/
.idea/
*.swp
*.swo/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Jupyter
.ipynb_checkpoints/

# Local Docker override
docker-compose.override.yml
